# ==============================================================================
# Security: NEVER commit unencrypted Kubernetes or Talos secrets to Git!
# ==============================================================================

# Client credentials and cluster configs containing private keys & CA certs
talosconfig
kubeconfig
controlplane.yaml
worker.yaml

# Wildcards for certificates and keys
*.key
*.pem
*.crt
*.p12

# Environment and local overrides
.env
.env.local
*.local.yaml

# Temporary and editor files
.DS_Store
.vscode/
.idea/
*.swp

# Terraform / OpenTofu local directories and state files
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
